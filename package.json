{
  "name": "cerebro-modeler",
  "version": "1.3.0",
  "description": "cerebro-modeler scans your SQL Server schema and generates clean, type-safe TypeORM entities. Powered by your database. Inspired by Cerebro",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0",
  "bin": {
    "cerebro-modeler": "./dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlosFerOrduna/cerebro-modeler"
  },
  "homepage": "https://github.com/CarlosFerOrduna/cerebro-modeler#readme",
  "files": [
    "dist/",
    "src/",
    "!src/**/*.spec.ts"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\""
  },
  "dependencies": {
    "mssql": "^11.0.1",
    "pluralize": "^8.0.0",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mssql": "^9.1.7",
    "@types/node": "^24.3.0",
    "@types/pluralize": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "cerebro-modeler",
    "typeorm",
    "mssql",
    "cli",
    "entity-generator",
    "database-first",
    "codegen",
    "schema-introspection",
    "npx"
  ]
}
